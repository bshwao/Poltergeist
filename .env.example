CARLA_HOST=localhost
CARLA_PORT=2000
CARLA_TIMEOUT=10
CARLA_AUTO_START=true
# Leave blank to discover common local CARLA folders, or set the full executable path.
CARLA_EXECUTABLE=
CARLA_STARTUP_TIMEOUT_S=120
# Default for new instances; the dashboard can choose Low or Epic per launch.
CARLA_QUALITY=Low
DATABASE_URL=sqlite:///./storage/database/poltergeist.db
STORAGE_DIR=storage
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SIMULATION_QUEUE_SIZE=100
SIMULATION_PROGRESS_INTERVAL_S=0.25
SIMULATION_SHUTDOWN_TIMEOUT_S=15

# Optional local OpenAI assistance. No provider traffic until a disclosure is approved.
# Choose an available Responses API model supporting strict function tools.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_DAILY_REQUEST_LIMIT=10
OPENAI_DAILY_OUTPUT_TOKEN_LIMIT=8192

# Optional GitHub check publication: explicit GitHub App installation credentials.
# Repository permissions: Contents read, Checks write. No ambient gh/Git token is read.
GITHUB_ENABLED=false
GITHUB_CHECKS_TOKEN=
GITHUB_REPOSITORY=
GITHUB_APP_ID=
GITHUB_CHECK_NAME=Poltergeist regression
GITHUB_DAILY_PUBLISH_LIMIT=20
