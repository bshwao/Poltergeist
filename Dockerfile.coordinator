FROM node:24-alpine AS dashboard
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/hosted.html frontend/tsconfig.json frontend/vite.hosted.config.ts ./
COPY frontend/src/ src/
# A public installer URL is optional. Never pass credentials in a Vite value.
ARG VITE_COMPANION_DOWNLOAD_URL=""
RUN npm run build:hosted

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements-coordinator.lock requirements-core.lock ./
RUN pip install --no-cache-dir -r requirements-coordinator.lock && pip check
COPY coordinator/ coordinator/
COPY scenarios/ scenarios/
COPY shared/ shared/
COPY --from=dashboard /build/dist-hosted/ hosted/

RUN groupadd --gid 10001 poltergeist \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin poltergeist \
    && install -d -m 0700 -o 10001 -g 10001 /data/coordinator
USER 10001:10001
EXPOSE 8443
ENTRYPOINT ["python", "-m", "coordinator"]
