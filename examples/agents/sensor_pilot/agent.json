{
  "protocol_version": "1.3",
  "agent_id": "sensor-pilot-example",
  "name": "Camera and LiDAR teaching controller",
  "version": "0.1.0",
  "entry_point": "agent:SensorPilot",
  "observation_mode": "sensors",
  "navigation_mode": "provided_route",
  "sensors": [
    {
      "id": "front-camera", "type": "sensor.camera.rgb",
      "attributes": {"image_size_x": 320, "image_size_y": 180, "fov": 90.0},
      "mount": {"position": {"x": 1.5, "z": 2.0}}
    },
    {
      "id": "roof-lidar", "type": "sensor.lidar.ray_cast",
      "attributes": {"channels": 32, "range": 60.0, "points_per_second": 56000, "rotation_frequency": 20.0},
      "mount": {"position": {"x": 1.5, "z": 2.0}}
    }
  ],
  "configuration": {"cruise_speed_mps": 4.0}
}
