{
  "name": "poltergeist-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:hosted": "tsc --noEmit && vite build --config vite.hosted.config.ts",
    "preview": "vite preview",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:hosted": "playwright test --config playwright.hosted.config.ts",
    "contracts:generate": "node scripts/generate-types.mjs",
    "contracts:check": "node scripts/generate-types.mjs --check"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "json-schema-to-typescript": "^16.0.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
